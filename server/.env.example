# Rocket Candle attestation service

# Port the service listens on
PORT=4000

# Secret used to sign session cookies. Any long random string.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=6h

# The key that countersigns finished runs.
#
# This key never needs funds - it only signs, players submit their own
# transactions - so it should be a fresh key that holds nothing. Its address
# must match the contract's runAttestor, and if it ever leaks, rotate it with
# setRunAttestor rather than redeploying.
ATTESTATION_PRIVATE_KEY=

# The game contract the signatures are bound to, and the chain it lives on.
# Getting either wrong makes every attestation unusable, which is why the
# service prints both at startup.
GAME_CONTRACT_ADDRESS=
CHAIN_ID=50312

# How long a signed run stays claimable, in seconds
ATTESTATION_TTL_SECONDS=600

# Where the game is served from, comma separated
CORS_ORIGINS=http://localhost:3000
