# Somnia Network Configuration
PRIVATE_KEY=your_private_key_without_0x_prefix
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# The attestation service's signing address.
#
# Scores are only accepted when countersigned by this key, so the contract
# needs it at deploy time. It is NOT a private key - the service holds that,
# and it never needs funds. If it is ever compromised, rotate it on the
# deployed contract with setRunAttestor rather than redeploying.
RUN_ATTESTOR_ADDRESS=

# The token the weekly pot pays out in - USDso on Somnia.
# Shannon testnet: 0x9c32F3827A1a99f0cf9B213de8b53eC3d57bb171
STAKE_TOKEN_ADDRESS=

# Contract addresses (updated after deployment)
ROCKET_CANDLE_GAME_ADDRESS=
